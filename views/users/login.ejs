<% layout("/layouts/boilerplate") %>

<body>
  <div class="row">
    <div class="col-md-8 offset-md-2 col-10 offset-1">
      <h3 class="mt-4 mb-3"><span style="color: #ff385c;">Login</span> Your Account</h3>
      <form class="validateForm" method="Post" action="/login" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label">Username: </label>
          <input type="text" placeholder="abc1234" name="username" id="username" class="form-control" data-validate data-required="true" data-min-length-s="3" />
          <div class="invalid-feedback"></div>
        </div>

        <div class="mb-3 password_div">
          <label for="password" class="form-label">Password: </label>
          <input type="password" placeholder="********" name="password" id="password" class="form-control" data-validate data-required="true" data-password="8" />
          <div class="invalid-feedback"></div>
          <div class="show-hide-forget-container mt-3">
            <button type="button" class=" btn btn-outline-dark btn-sm  password_toggler hide-password">Show Password</button>
            <a href="">Forget Password ? </a>
          </div>
        </div>

        <button class="btn btn-danger w-25 add">Login</button>
        <a href="/signup" class="login">Create a new account</a>
      </form>
    </div>
  </div>
</body>