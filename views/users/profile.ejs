<% layout("/layouts/boilerplate") %>

<body>
  <div class="row ">
    <div class="col-md-8 offset-md-2 col-10 offset-1 mb-3">

      <h3 class="mt-4 mb-3">
        <span style="color: #ff385c;">Profile</span>
      </h3>

      <div class="row profile-container">

        <div class="profile-image">
          <img src="<%= user.image?.url || '/images/logo_image.png' %>" alt="Profile image">
        </div>

        <div class="profile-info">

          <div>
            <%= user.fullname || "Add your full name" %>
          </div>

          <div>
            @<%= user.username %>
          </div>

          <div>
            📍 <%= user.location || "Add your location" %>
          </div>

          <div>
            <%= user.email %>
            <%if(!user.isVerified){%>
            &nbsp;&nbsp;<form action="/verify-email/send" method="POST" style="display: inline-block;">
              <button type="submit" class="btn btn-danger btn-sm">
                Verify
              </button>
            </form>
            <%}%>

          </div>

          <div class="profile-bio">
            <div>
              <%= user.bio || "Add a bio to tell people about yourself." %>
          </div>
        </div>

        <div class="profile-edit text-center mt-5 d-flex justify-content-around">
          <a href="/user/<%= user._id %>/edit">
            <button class="btn btn-danger">Edit Profile</button>
          </a>
          <a href="/user/<%= user._id %>/change-password">
            <button class="btn btn-danger">Change Password</button>
          </a>
        </div>

      </div>
    </div>
  </div>
  <% if(personalListings.length > 0){%>
  <div class=" mt-2 mb-3 h-1 col-md-8 offset-md-2 col-10 offset-1 border-top">
  </div>
  <div class="row col-md-8 offset-md-2 col-10 offset-1">
    <h4 class="mt-2"><span style="color: #FF385C;">@<%=user.username.toUpperCase()%>,</span> Your Listings</h4>
    <div class="row row-cols-1 row-cols-md-2 row-cols-sm-1">
      <% for(let i = 0; i < personalListings.length; i++) { %>

      <a href="/listings/<%= personalListings[i]._id %>" class="listing-link">
        <div class="listing-card card col">
          <img src="<%= personalListings[i].image.url %>" class="card-img-top" alt="image" style="height: 20rem;">

          <div class="card-img-overlay">
          </div>

          <div class="card-body">
            <p class="card-text mb-0">
              <b><%= personalListings[i].title %></b><br>
              &#8377; <%= personalListings[i].price.toLocaleString("en-IN") %> / night
            </p>
          </div>
        </div>
      </a>
      <% } %>
    </div>
  </div>
  <div class="pagination mb-3">
    <%if(page > 1){%>
    <div class="previous_container">
      <a href="/user/profile?page=<%=page-1%>&limit=<%=limit%>">
        <i class="fa-solid fa-circle-left page_navigators"></i></a>
    </div>

    <%}%>
    
  <div class="total_pages_num">
      <%=page%> / <%=total_pages%>
  </div>
  <%if(total_pages > page){%>
  <div class="next_container">
    <a href="/user/profile?page=<%=page+1%>&limit=<%=limit%>">
      <i class="fa-solid fa-circle-right page_navigators"></i>

    </a>
  </div>
  <%}%>
  </div>
  <%}%>

</body>