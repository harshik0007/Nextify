<% layout("/layouts/boilerplate") %>

<body>
  <div class="row">
    <div class="col-md-8 offset-md-2 col-10 offset-1">
      <h3 class="mt-4 mb-4"><span style="color: #ff385c;">Verify </span>Otp</h3>
      <form class="validateForm" method="POST" action="/forgot-password/verify" novalidate>
        <div class="mb-3">
          <label for="otp" class="form-label">Enter OTP:</label>

          <input type="text" placeholder="******" name="otp" id="otp" class="form-control" data-validate data-required="true" data-number-length="6" />

          <div class="invalid-feedback"></div>
        </div>

        <button class="btn btn-danger w-25 add mt-1">
          Verify OTP
        </button>

        <a href="/forgot-password" class="mb-4 mt-1" style="display: block; text-decoration: none; color: #ff385c;">
          Go Back To Previous Page
        </a>
      </form>
    </div>
  </div>
</body>