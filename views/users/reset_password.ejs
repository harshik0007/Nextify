<% layout("/layouts/boilerplate") %>

<body>
  <div class="row">
    <div class="col-md-8 offset-md-2 col-10 offset-1">

      <h3 class="mt-4 mb-4">
        <span style="color: #ff385c;">Reset</span> Your Password
      </h3>

      <form class="validateForm" method="POST" action="/forgot-password/reset" novalidate>

        <div class="mb-3 password_div">
          <label for="new_password" class="form-label">
            New Password:
          </label>

          <input type="password" placeholder="********" name="new_password" id="new_password" class="form-control" data-validate data-required="true" data-password="8" />

          <div class="invalid-feedback"></div>
        </div>

        <div class="mb-5">
          <label for="confirm-password" class="form-label">
            Confirm New Password:
          </label>

          <input type="password" placeholder="********" id="confirm-password" class="form-control" data-validate data-required="true" data-same-as="new_password" />

          <div class="invalid-feedback"></div>

          <div class="show-hide-forget-container mt-3">
            <button type="button" class="btn btn-outline-dark btn-sm password_toggler hide-password">
              Show Password
            </button>
          </div>
        </div>

        <button class="btn btn-danger w-25 add mt-1">
          Reset Password
        </button>

      </form>

    </div>
  </div>
</body>