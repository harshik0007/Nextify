<% layout("/layouts/boilerplate") %>

<body>
  <div class="row mb-4">
    <div class="col-md-8 offset-md-2 col-10 offset-1">
      <h3 class="mt-4 mb-3"><span style="color: #ff385c;">Create</span> a New Account</h3>
      <form class="validateForm" method="Post" action="/signup" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label">Username: </label>
          <input type="text" placeholder="abc1234" name="username" id="username" class="form-control" data-validate data-required="true" data-min-length-s="3" />
          <div class="valid-feedback">Good Username</div>
          <div class="invalid-feedback"></div>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">Email: </label>
          <input type="text" name="email" id="email" placeholder="abc@gmail.com" class="form-control" data-validate data-required="true" data-email="true" />
          <div class="invalid-feedback"></div>
        </div>

        <div class="mb-3 password_div">
          <label for="password" class="form-label">Password: </label>
          <input type="password" placeholder="********" name="password" id="password" class="form-control" data-validate data-required="true" data-password="8" />
          <div class="invalid-feedback"></div>
        </div>

        <div class="mb-5">
          <label for="confirm-password" class="form-label">Password: </label>
          <input type="password" placeholder="********" id="confirm-password" class="form-control" data-validate data-required="true" data-same-as="password" />
          <div class="invalid-feedback"></div>
          <div class="show-hide-forget-container mt-3">
            <button type="button" class=" btn btn-outline-dark btn-sm  password_toggler hide-password">Show Password</button>
          </div>
        </div>

        <button class="btn btn-danger w-25 add">SignUp</button>
        <a href="/login" class="login">Alerady have account ? Log in here</a>
      </form>
    </div>
    <div class="col-md-8 offset-md-2 col-10 offset-1">
      <a href="/auth/google" class="btn btn-outline-dark w-100 d-flex align-items-center justify-content-center">
        <img src="/images/google.png" alt="google_login" height="28px" width="28px">&nbsp;&nbsp;<span style="font-size: 1.1rem;">Continue with Google</span>
      </a>
    </div>
  </div>
</body>