<% layout("/layouts/boilerplate") %>

<body>
  <div class="row">
    <div class="col-md-8 offset-md-2 col-10 offset-1">
      <h3 class="mt-4 mb-3">Create a New Account</h3>
      <form class="validateForm" method="Post" action="/signup" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label">Username: </label>
          <input type="text" placeholder="abc1234" name="user[username]" id="username" class="form-control" data-validate data-required="true" data-min-length-s="3" />
          <div class="valid-feedback">Good Username</div>
          <div class="invalid-feedback"></div>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">Email: </label>
          <input type="text" name="user[email]" id="email" placeholder="abc@gmail.com" class="form-control" data-validate data-required="true" data-email="true" />
          <div class="invalid-feedback"></div>
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">Password: </label>
          <input type="password" placeholder="********" name="user[password]" id="password" class="form-control" data-validate data-required="true" data-password="8" />
          <div class="invalid-feedback"></div>
        </div>

        <div class="mb-5">
          <label for="confirm-password" class="form-label">Password: </label>
          <input type="password" placeholder="********" id="confirm-password" class="form-control" data-validate data-required="true" data-same-as="password" />
          <div class="invalid-feedback"></div>
        </div>

        <button class="btn btn-danger w-25 mb-5 add">SignUp</button>
      </form>
    </div>
  </div>
</body>