<% layout("/layouts/boilerplate") %>

<body>
  <div class="row">
    <div class="col-md-8 offset-md-2 col-10 offset-1">
      <h3 class="mt-4 mb-4"><span style="color: #ff385c;">Reset</span> Your Password</h3>
      <form class="validateForm" method="Post" action="/forgot-password/send-otp" novalidate>
        <div class="mb-3">
          <label for="email" class="form-label">e-mail </label>
          <input type="text" placeholder="Enter Your Email" name="email" id="email" class="form-control" data-validate data-required="true" data-email="true" />
          <div class="invalid-feedback"></div>
        </div>
        <button class="btn btn-danger w-25 add mt-3 mb-2">Get Otp</button>
      </form>
    </div>
  </div>


</body>