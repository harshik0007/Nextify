<% layout("/layouts/boilerplate") %>

<body>
  <div class="row mt-3">
    <div class="col-md-8 offset-md-3 col-10 offset-1 ">
      <h3><%= listing.title %></h3>
    </div>

    <div class=" listing-card card col-md-6 offset-md-3 col-10 offset-1">
      <img src="<%= listing.image %>" class="card-img-top show-img" alt="Image" />
      <div class="card-body">
        <p class="card-text">
          <%= listing.description %> <br />
          &#8377; <%= listing.price.toLocaleString("en-In") %> <br />
          <%= listing.country %> <br />
          <%= listing.location %>
        </p>
      </div>
    </div>

    <div class="col-md-8 offset-md-3 col-10 offset-1 mb-5 btn-container">
      <a class="btn btn-danger col-md-2 col-3" href="/listings/<%= listing._id %>/edit">Edit</a>
      <form class="offset-1" method="post" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark">Delete</button>
      </form>
    </div>

    <!-- reviews form -->
    <div class="col-md-8 offset-md-3 col-10 offset-1 mb-4">
      <hr>
      <h4>Leave a review</h4>
      <form method="post" action="/listings/<%= listing._id %>/reviews" novalidate class="validateForm">
        <div class="mb-3 mt-3">
          <label class="form-label" for="rating">Rating</label>
          <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
        </div>
        <div class="mb-3 mt-3">
          <label class="form-label" for="comment">Comment</label>
          <textarea class="form-control" id="comment" name="review[comment]" rows="5" cols="50" data-validate data-required="true" data-min-length-s="3"></textarea>
          <div class="invalid-feedback"></div>
        </div>
        <button class="btn btn-outline-dark ">Rate</button>
      </form>
    </div>

    <div class="col-md-8 offset-md-3 col-10 offset-1 mb-4">
      <hr>
      <h4>All Reviews</h4>
      <div class="row">
        <% for(i = 0; i < listing.reviews.length; i++) {%>
        <div class="card col-md-5 mb-3 ms-2 p-2">
          <h5 class="carr-title">Jane Doe</h5>
          <p class="card-text"><%= listing.reviews[i].comment%></p>
          <p class="card-text d-flex aling-items-center"><%= listing.reviews[i].rating%> Stars</p>
          <form action="/listings/<%= listing._id %>/reviews/<%= listing.reviews[i]._id %>?_method=DELETE" method="POST">
            <button class="btn btn-sm btn-dark">Delete</button>
          </form>
        </div>
        <%} %>
      </div>

    </div>
  </div>
</body>