<% layout("/layouts/boilerplate") %>

<body>
  <div class="row mt-3">
    <div class="col-md-8 offset-md-3 col-10 offset-1">
      <h3>Listing Details</h3>
    </div>

    <div class="card col-md-6 offset-md-3 col-10 offset-1">
      <img
        src="<%= listing.image %>"
        class="card-img-top show-img"
        alt="Image"
      />
      <div class="card-body">
        <p class="card-text">
          <b><%= listing.title %></b> <br />
          <%= listing.description %> <br />
          &#8377; <%= listing.price.toLocaleString("en-In") %> <br />
          <%= listing.country %> <br />
          <%= listing.location %>
        </p>
      </div>
    </div>

    <div class="col-md-8 offset-md-3 col-10 offset-1 mb-5 btn-container">
      <a
        class="btn btn-danger col-md-2 col-3"
        href="/listings/<%= listing._id %>/edit"
        >Edit</a
      >
      <form
        class="offset-1"
        method="post"
        action="/listings/<%= listing._id %>?_method=DELETE"
      >
        <button class="btn btn-dark">Delete</button>
      </form>
    </div>
  </div>
</body>
