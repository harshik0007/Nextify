<% layout("/layouts/boilerplate") %>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
</script>

<body>
  <div class="row mt-3">
    <div class="col-md-8 offset-md-2 col-10 offset-1 ">
      <h3><%= listing.title %></h3>
    </div>

    <div class=" listing-card card col-md-8 offset-md-2 col-10 offset-1">
      <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="Image" />
      <div class="card-body">
        <p class="card-text mt-1">
          Owned by <b><i><%= listing.owner.username %></i></b>
        </p>
        <p class="card-text"><%= listing.description %> </p>
        <p class="card-text">&#8377; <%= listing.price.toLocaleString("en-In") %> </p>
        <p class="card-text"><%= listing.category %></p>
        <p class="card-text"><%= listing.country %> </p>
        <p class="card-text"><%= listing.location %></p>

      </div>
    </div>

    <%if (currUser && currUser._id.equals(listing.owner._id)){ %>
    <div class="col-md-8 offset-md-2 col-10 offset-1 mb-3 btn-container">
      <a class="btn btn-danger col-md-2 col-3" href="/listings/<%= listing._id %>/edit">Edit</a>
      <form class="offset-1" method="post" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark">Delete</button>
      </form>
    </div>
    <%}%>
    <div class="col-md-8 offset-md-2 col-10 offset-1 mb-2">
      <hr>
    </div>
    
    <div class="col-md-8 offset-md-2 col-10 offset-1 mb-2">
      <div class="d-flex justify-content-around align-items-center">
        <div class="d-flex align-items-center flex-column">
          <div style="color: #ff385c;">
            <b>
              <%if(ratingAvg){%>
    <%= ratingAvg %>
    <%} else{%>
    No Rating Yet
    <%}%> / 5
          </b>
  </div>
  <div>Rating</div>
  </div>
  <div style="height: 100px; width: 1px; border: 1px solid black;"></div>
  <div class="d-flex align-items-center flex-column">
    <div style="color: #ff385c;"><b>
              <%if(listing.reviews.length){%>
    <%= listing.reviews.length %>
    <%} else{%>
    No rating Yet
    <%}%>
          </b></div>
    <div>Total Rating</div>
  </div>
  </div>
  <hr>
  </div>


  <!-- reviews form -->
  <% if(currUser){ %>
    <div class="col-md-8 offset-md-2 col-10 offset-1 mb-2">

      <h4>Leave a review</h4>
      <form method="post" action="/listings/<%= listing._id %>/reviews" novalidate class="validateForm">
        <div class="mb-3 mt-3">
          <label class="form-label" for="rating">Rating</label>
          <!-- <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range"> -->
          <fieldset class="starability-slot">
            <input type="radio" id="first-rate1" name="review[rating]" value="1" checked />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>
        <div class="mb-3 mt-3">
          <label class="form-label" for="comment">Comment</label>
          <textarea class="form-control" id="comment" name="review[comment]" rows="5" cols="50" data-validate data-required="true" data-min-length-s="3"></textarea>
          <div class="invalid-feedback"></div>
        </div>
        <button class="btn btn-outline-dark ">Rate</button>
      </form>
      <hr>
    </div>
    <% } %>

    <%if(listing.reviews.length > 0){%>
    <div class="col-md-8 offset-md-2 col-10 offset-1 mb-2">

      <h4 class="mb-4">All Reviews</h4>
      <div class="row d-flex justify-content-between">
        <% for(i = 0; i < listing.reviews.length; i++) { %>
        <div class="card col-lg-5 mb-3 ms-2 p-3">
          <div class="d-flex align-items-center">
            <img src="<%= listing.reviews[i].author?.image?.url || '/images/logo_image.png' %>" alt="User" height="35px" width="35px" style="border-radius: 50%; box-shadow: 0px 0px 4px black;">
            <h5 class="carr-title" style="margin: 0; margin-left: 1rem;">@<%=listing.reviews[i].author.username %></h5>
          </div>
          <p class=" card-text" style="margin-left: 3.2rem;"><%= listing.reviews[i].comment %></p>
          <p class="starability-result" style="margin-left: 3rem;" data-rating="<%= listing.reviews[i].rating %>">
          </p>

          <% if(currUser && listing.reviews[i].author._id.equals(currUser._id)){ %>
          <form action="/listings/<%= listing._id %>/reviews/<%= listing.reviews[i]._id %>?_method=DELETE" method="POST">
            <button class="btn btn-sm btn-dark">Delete</button>
          </form>
          <% } %>
        </div>
        <% } %>
      </div>
      <hr>
    </div>
    <%}%>
    <div class="col-md-8 offset-md-2 col-10 offset-1 mb-4">
      <h4 class="mb-3">Where You'll be</h4>
      <div id="map"></div>
  </div>
  </div>
  </div>
</body>
<script id="listing-data" type="application/json">
  <%- JSON.stringify(listing) %>
    </script>
    <script src="/js/map.js"></script>