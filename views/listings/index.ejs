<script>
const filters = document.querySelector("#filters");

const leftBtn = document.querySelector(".filter_navigation:first-child");
const rightBtn = document.querySelector(".filter_navigation:last-child");

rightBtn.addEventListener("click", () => {
    filters.scrollBy({
        left: 300,
        behavior: "smooth"
    });
});

leftBtn.addEventListener("click", () => {
    filters.scrollBy({
        left: -300,
        behavior: "smooth"
    });
});

let taxToggle = document.querySelector("#switchCheckDefault");
let taxDisplays = document.querySelectorAll(".taxDisplay")
taxToggle.addEventListener("click", () => {
  for(taxDisplay of taxDisplays){
    if(taxDisplay.style.display != "inline"){
      taxDisplay.style.display = "inline"
    } else {
      taxDisplay.style.display = "none"
    }
  }
})

let filterBtn = document.querySelector(".filter-button");
let min_screen_filter = document.querySelector("#filter_min_screen")
filterBtn.addEventListener("click", () => {
  if(min_screen_filter.style.display != "flex"){
    min_screen_filter.style.display = "flex";
  } else {
    min_screen_filter.style.display = "none";
  }
})

let cross = document.querySelector(".fa-xmark");
cross.addEventListener("click", () => {
  min_screen_filter.style.display = "none";
})
</script>