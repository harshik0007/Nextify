<% layout("/layouts/boilerplate") %>
<style>
  #filters {
    display: flex;
    margin-top: 2rem;
    width: 60vw;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }

  #filters::-webkit-scrollbar {
    display: none;
  }

  .filter {
    text-align: center;
    margin-right: 3rem;
    cursor: pointer;
    flex-shrink: 0;
  }

  .filter p {
    font-size: 0.7rem;

  }

  .filter-container {
    display: flex;
    align-items: center;
  }

  .filter_navigation i {
    font-size: 1.5rem;
    color: #ff385c;
  }

  .filter-link {
    text-decoration: none;
    color: black;
    opacity: 0.7;
    transition: all 0.15s ease-in-out;
  }

  .filter-link:hover {
    opacity: 1;
    color: #ff385c;
  }
</style>

<body>
  <div class="filter-container">
    <div class="filter_navigation me-2"><i class="fa-solid fa-circle-arrow-left"></i></div>
    <div id="filters" class="mb-2">

      <div class="filter">
        <a href="/listings/category/Trending" class="filter-link">
          <div><i class=" fa-solid fa-fire"></i>
          </div>
          <p>
            Tranding
          </p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings/category/Room" class="filter-link">
          <div><i class=" fa-solid fa-house"></i></div>
          <p>
            Room
          </p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings/category/Camping" class="filter-link">
          <div><i class="fa-solid fa-campground"></i></div>
          <p>
            Campfire
          </p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings/category/Castle" class="filter-link">
          <div><i class="fa-brands fa-fort-awesome"></i></div>
          <p>
            Castle
          </p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings/category/Beach" class="filter-link">
          <div><i class="fa-solid fa-umbrella-beach"></i></div>
          <p>
            Beach
          </p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings/category/Mountain" class="filter-link">
          <div><i class="fa-solid fa-mountain-sun"></i></div>
          <p>
            Mountain
          </p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings/category/Top Rated" class="filter-link">
          <div><i class="fa-solid fa-star"></i></div>
          <p>
            Top Rated
          </p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings/category/Farm" class="filter-link">
          <div><i class="fa-solid fa-tractor"></i></div>
          <p>
            Farm
          </p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings/category/Mountain City" class="filter-link">
          <div><i class="fa-solid fa-mountain-city"></i></div>
          <p>
            Mountain City
          </p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings/category/Amazing Pools" class="filter-link">
          <div><i class="fa-solid fa-person-swimming"></i></div>
          <p>
            Amazing Pools
          </p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings/category/Boats" class="filter-link">
          <div><i class="fa-solid fa-sailboat"></i></div>
          <p>
            Boats
          </p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings/category/Arctic" class="filter-link">
          <div><i class="fa-solid fa-snowflake"></i></div>
          <p>
            Arctic
          </p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings/category/Pet Friendly" class="filter-link">
          <div><i class="fa-solid fa-dog"></i></div>
          <p>
            Pet Friendly
          </p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings/category/Luxury" class="filter-link">
          <div><i class="fa-solid fa-gem"></i></div>
          <p>
            Luxury
          </p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings/category/Hotels_Resorts" class="filter-link">
          <div><i class="fa-solid fa-hotel"></i></div>
          <p>
            Hotels/Resorts
          </p>
        </a>
      </div>
      <div class="filter">
        <a href="/listings/category/City" class="filter-link">
          <div><i class="fa-solid fa-city"></i></div>
          <p>
            City
          </p>
        </a>
      </div>
    </div>
    <div class="filter_navigation ms-2"><i class="fa-solid fa-circle-arrow-right"></i></div>
  </div>
  <div class="row row-cols-1 row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for(let i = 0; i < Listings.length; i++) { %>

    <a href="/listings/<%= Listings[i]._id %>" class="listing-link">
      <div class="listing-card card col">
        <img src="<%= Listings[i].image.url %>" class="card-img-top" alt="image" style="height: 20rem;">

        <div class="card-img-overlay">
        </div>

        <div class="card-body">
          <p class="card-text mb-0">
            <b><%= Listings[i].title %></b><br>
            &#8377; <%= Listings[i].price.toLocaleString("en-IN") %> / night
          </p>
        </div>
      </div>
    </a>
    <% } %>
  </div>

  <div class="pagination mb-3">
    <%if(page > 1){%>
    <div class="previous_container">
      <a href="/listings?page=<%=page-1%>&limit=<%=limit%>">
        <i class="fa-solid fa-circle-left page_navigators"></i></a>
    </div>

    <%}%>
    
  <div class="total_pages_num">
      <%=page%> / <%=total_pages%>
  </div>
  <%if(total_pages > page){%>
  <div class="next_container">
    <a href="/listings?page=<%=page+1%>&limit=<%=limit%>">
      <i class="fa-solid fa-circle-right page_navigators"></i>

    </a>
  </div>
  <%}%>
  </div>
</body>

<script>
const filters = document.querySelector("#filters");

const leftBtn = document.querySelector(".filter_navigation:first-child");
const rightBtn = document.querySelector(".filter_navigation:last-child");

rightBtn.addEventListener("click", () => {
    filters.scrollBy({
        left: 300,
        behavior: "smooth"
    });
});

leftBtn.addEventListener("click", () => {
    filters.scrollBy({
        left: -300,
        behavior: "smooth"
    });
});
</script>