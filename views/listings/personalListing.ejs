<% layout("/layouts/boilerplate") %>

<body>
  <h4 class="mt-2"><span style="color: #FF385C;">@<%=username.toUpperCase()%>,</span> Your Listings</h4>
  <div class="row row-cols-1 row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for(let i = 0; i < allPersonalListings.length; i++) { %>

    <a href="/listings/<%= allPersonalListings[i]._id %>" class="listing-link">
      <div class="listing-card card col">
        <img src="<%= allPersonalListings[i].image.url %>" class="card-img-top" alt="image" style="height: 20rem;">

        <div class="card-img-overlay">
        </div>

        <div class="card-body">
          <p class="card-text mb-0">
            <b><%= allPersonalListings[i].title %></b><br>
            &#8377; <%= allPersonalListings[i].price.toLocaleString("en-IN") %> / night
          </p>
        </div>
      </div>
    </a>
    <% } %>
  </div>
</body>