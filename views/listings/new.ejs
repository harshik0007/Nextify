<% layout("/layouts/boilerplate") %>

<body>
  <div class="row">
    <div class="col-md-8 offset-md-2 col-10 offset-1">
      <h3 class="mt-4 mb-3">Create a New Listing</h3>
      <form class="validateForm" method="Post" action="/listings" novalidate enctype="multipart/form-data">
        <div class="mb-3">
          <label for="title" class="form-label">Title: </label>
          <input type="text" placeholder="Enter catchy title" name="listing[title]" id="title" class="form-control" data-validate data-required="true" data-min-length-s="5" data-max-length-s="100" />
          <div class="valid-feedback">Title looks Good!</div>
          <div class="invalid-feedback"></div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Textarea: </label>
          <textarea name="listing[description]" id="description" placeholder="Enter description" class="form-control" data-validate data-required="true" data-min-length-s="10" data-max-length-s="1000"></textarea>
          <div class="invalid-feedback"></div>
        </div>

        <div class="mb-3">
          <label for="image" class="form-label">Upload Image:</label>
          <input type="file" name="listing[image]" id="image" class="form-control" data-validate data-validate data-required="true" data-max-size="5242880" data-max-files="1" data-types="image/jpeg,image/png,image/jpg" />
          <div class="invalid-feedback"></div>
        </div>


        <div class="mb-3">
          <label for="category" class="form-label">Category:</label>
          <select class="form-select form-select" name="listing[category]" id="category" data-validate data-required="true">
            <option value="Trending">Trending</option>
            <option value="Room">Room</option>
            <option value="Camping">Camping</option>
            <option value="Castle">Castle</option>
            <option value="Beach">Beach</option>
            <option value="Mountain">Mountain</option>
            <option value="Top Rated">Top Rated</option>
            <option value="Farm">Farm</option>
            <option value="Mountain City">Mountain City</option>
            <option value="Amazing Pools">Amazing Pools</option>
            <option value="Boats">Boats</option>
            <option value="Arctic">Arctic</option>
            <option value="Pet Friendly">Pet Friendly</option>
            <option value="Luxury">Luxury</option>
            <option value="Hotels_Resorts" selected>Hotels/Resorts</option>
            <option value="City">City</option>
          </select>
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price: </label>
            <input placeholder="2000" name="listing[price]" id="price" class="form-control" data-validate data-required="true" data-min-value="1" />
            <div class="invalid-feedback"></div>
          </div>

          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country: </label>
            <input type="text" placeholder="India" name="listing[country]" id="country" class="form-control" data-validate data-required="true" data-min-length-s="2" data-max-length-s="100" />
            <div class="invalid-feedback"></div>
          </div>
        </div>

        <div class="mb-5">
          <label for="location" class="form-label">Location: </label>
          <input type="text" placeholder="Rajkot, Gujarat" name="listing[location]" id="location" class="form-control" data-validate data-required="true" data-min-length-s="2" data-max-length-s="200" />
          <div class="invalid-feedback"></div>
        </div>

        <button class="btn btn-danger w-25 mb-5 add">Add</button>
      </form>
    </div>
  </div>
</body>