<% layout("/layouts/boilerplate") %>

<body>
  <div class="row">
    <div class="col-md-8 offset-md-2 col-10 offset-1">
      <h3 class="mt-4 mb-3">Edit Your Listing</h3>
      <form class="validateForm" method="Post" action="/listings/<%= listing._id %>?_method=PUT" novalidate enctype="multipart/form-data">
        <div class="mb-3">
          <label for="title" class="form-label">Title: </label>
          <input type="text" placeholder="Enter catchy title" name="listing[title]" id="title" class="form-control" value="<%= listing.title %>" data-validate data-required="true" data-min-length-s="5" data-max-length-s="100" />
          <div class="invalid-feedback"></div>
        </div>

        <div class="mb-3">
          <label for="textarea" class="form-label">Textarea: </label>
          <textarea name="listing[description]" id="description" placeholder="Enter description" id="textarea" class="form-control" data-validate data-required="true" data-min-length-s="10" data-max-length-s="1000">
<%= listing.description %></textarea>
          <div class="invalid-feedback"></div>
        </div>

        <div class="mb-3">
          <p>Original Image(For preview only)</p>
          <img src="<%= originalUrl %>" alt="image_preview" height="175px" width="250px">
        </div>

        <div class="mb-3">
          <label for="image" class="form-label">Upload New Image: </label>
          <input type="file" name="listing[image]" id="image" class="form-control" />
          <div class="invalid-feedback"></div>
        </div>

        <div class="mb-3">
          <label for="category" class="form-label">Category:</label>
          <select class="form-select form-select" name="listing[category]" id="category" data-validate data-required="true">
            <option value="Trending" <%= listing.category === "Trending" ? "selected" : "" %>>Trending</option>
            <option value="Room" <%= listing.category === "Room" ? "selected" : "" %>>Room</option>
            <option value="Camping" <%= listing.category === "Camping" ? "selected" : "" %>>Camping</option>
            <option value="Castle" <%= listing.category === "Castle" ? "selected" : "" %>>Castle</option>
            <option value="Beach" <%= listing.category === "Beach" ? "selected" : "" %>>Beach</option>
            <option value="Mountain" <%= listing.category === "Mountain" ? "selected" : "" %>>Mountain</option>
            <option value="Top Rated" <%= listing.category === "Top Rated" ? "selected" : "" %>>Top Rated</option>
            <option value="Farm" <%= listing.category === "Farm" ? "selected" : "" %>>Farm</option>
            <option value="Mountain City" <%= listing.category === "Mountain City" ? "selected" : "" %>>Mountain City</option>
            <option value="Amazing Pools" <%= listing.category === "Amazing Pools" ? "selected" : "" %>>Amazing Pools</option>
            <option value="Boats" <%= listing.category === "Boats" ? "selected" : "" %>>Boats</option>
            <option value="Arctic" <%= listing.category === "Arctic" ? "selected" : "" %>>Arctic</option>
            <option value="Pet Friendly" <%= listing.category === "Pet Friendly" ? "selected" : "" %>>Pet Friendly</option>
            <option value="Luxury" <%= listing.category === "Luxury" ? "selected" : "" %>>Luxury</option>
            <option value="Hotels_Resorts" <%= listing.category === "Hotels_Resorts" ? "selected" : "" %>>Hotels/Resorts</option>
            <option value="City" <%= listing.category === "City" ? "selected" : "" %>>City</option>
          </select>
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price: </label>
            <input placeholder="2000" name="listing[price]" id="price" class="form-control" value="<%= listing.price %>" data-validate data-required="true" data-min-value="1" />
            <div class="invalid-feedback"></div>
          </div>

          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country: </label>
            <input type="text" placeholder="India" name="listing[country]" id="country" class="form-control" value="<%= listing.country %>" data-validate data-required="true" data-min-length-s="2" data-max-length-s="100" />
            <div class="invalid-feedback"></div>
          </div>
        </div>

        <div class="mb-5">
          <label for="location" class="form-label">Location: </label>
          <input type="text" placeholder="Rajkot, Gujarat" name="listing[location]" id="location" class="form-control" value="<%= listing.location %>" data-validate data-required="true" data-min-length-s="2" data-max-length-s="200" />
          <div class="invalid-feedback"></div>
        </div>

        <button class="btn btn-danger w-25 mb-5 edit">Edit</button>
      </form>
    </div>
  </div>
</body>